# ── Emails de leads (OBLIGATOIRE — tous les formulaires en dépendent) ────────
# Mot de passe d'application Google : myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes sur le compte Gmail).
# NB : un changement de mot de passe du compte Google révoque les app passwords
# existants — il faut alors en régénérer un et le mettre à jour ici ET sur Vercel.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ── URL canonique (metadata, sitemap, JSON-LD) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://autoecoledespaquerettes.fr

